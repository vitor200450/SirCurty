{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Sir Curty — Traces distribuídos: waterfall frontend → API → banco, latência por serviço e diagnóstico de erros.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Explorar Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Busca por serviço, operação ou atributo. Clique num trace para abrir o waterfall mostrando a cadeia completa.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {},
      "title": "Todos os Traces (frontend → API → banco)",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ resource.service.name=~\"sircurty-.*\" }",
          "limit": 30,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 101,
      "title": "Fluxo de Redirect (FE → API → DB)",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Traces do fluxo completo: clique no interstitial, requisição à API, query no Postgres e redirect. Mostra os 3 serviços num único trace.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 16 },
      "id": 2,
      "options": {},
      "title": "Redirect — Cadeia Completa",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ name=\"links.redirect\" }",
          "limit": 30,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "Diagnóstico",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Traces com status=error — mostra em qual serviço da cadeia a falha ocorreu.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 31 },
      "id": 3,
      "options": {},
      "title": "Traces com Erro",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ resource.service.name=~\"sircurty-.*\" && status=error }",
          "limit": 20,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Traces com duração acima de 1 segundo — identifica gargalos na cadeia.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 31 },
      "id": 4,
      "options": {},
      "title": "Traces Lentos (> 1s)",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ resource.service.name=~\"sircurty-.*\" && duration > 1s }",
          "limit": 20,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 103,
      "title": "Serviços",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latência média por serviço na cadeia — confirma que frontend, API e banco estão todos instrumentados.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 44 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Latência média por serviço",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_latency_sum{service=~\"sircurty-.*\"}[1m])) by (service) / sum(rate(traces_spanmetrics_latency_count{service=~\"sircurty-.*\"}[1m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Distribuição de spans por serviço — mostra que todos os componentes estão gerando traces.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 44 },
      "id": 6,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Spans por Serviço",
      "type": "piechart",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(traces_spanmetrics_calls_total{service=~\"sircurty-.*\"}) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["sircurty", "traces"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sir Curty — Traces Distribuídos",
  "uid": "sircurty-traces",
  "version": 3
}