      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "id": 3,
      "options": {},
      "title": "Traces Lentos (duração > 1s)",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"sircurty-.*\" && duration > 1s }",
          "limit": 20,
          "refId": "A",
          "tableType": "spans"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 103,
      "title": "Fluxo de Redirect",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Traces do fluxo de redirect: do clique no interstitial (frontend) até a query no banco. Mostra a cadeia completa de 3 serviços.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 36 },
      "id": 4,
      "options": {},
