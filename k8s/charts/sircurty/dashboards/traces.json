      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"sircurty-.*\" } | count() by(resource.service.name)",
          "refId": "A"
        }
      ]
