      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"sircurty-.*\" }",
          "limit": 20,
          "refId": "A",
          "tableType": "spans"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Análise de Erros",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
