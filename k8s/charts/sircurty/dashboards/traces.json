      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=~\"sircurty-.*\" && name=~\".*redirect.*\" }",
          "limit": 20,
          "refId": "A",
          "tableType": "spans"
        }
      ]
    },
    {
      "collapsed": false,
