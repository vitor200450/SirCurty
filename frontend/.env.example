# ============================================================
# Sir Curty Frontend — Environment variables template
# Copy this file to .env.development and fill in the values.
# NEVER commit files containing real credentials.
# ============================================================

# --- API ------------------------------------------------------
# Base URL of the Sir Curty API.
# Direct connection to the local backend.
VITE_API_BASE_URL=http://localhost:3000/api

# --- Google OAuth --------------------------------------------
# Google OAuth Client ID.
# Must match GOOGLE_CLIENT_ID configured in the backend.
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# --- Observability (optional) --------------------------------
# OpenTelemetry collector endpoint used for trace export.
# Used as a fallback when no runtime OTEL_ENDPOINT is configured.
# Set this to your actual collector endpoint if tracing is enabled.
VITE_OTEL_ENDPOINT=http://localhost:4318
