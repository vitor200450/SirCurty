# ============================================================
# Sir Curty API — Environment variables template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Server --------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ------------------------------------------------
POSTGRES_USER=sircurty
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sircurty

# PostgreSQL connection string used by Prisma and the API.
# Keep credentials consistent with the variables above.
DATABASE_URL=postgresql://sircurty:changeme@localhost:5432/sircurty?schema=public

# --- Google OAuth --------------------------------------------
# Google OAuth Client ID used by the backend to validate login.
# Must match the Client ID configured in the frontend.
GOOGLE_CLIENT_ID=your_google_client_id

# --- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Include every origin from which the browser accesses the API.
ALLOWED_ORIGINS=http://localhost:5173

# --- Application URLs ----------------------------------------
# Public base URL used to build short URLs returned by the API.
# Must NOT have a trailing slash.
APP_BASE_URL=http://localhost:3000

# Frontend base URL, used for frontend-related links or redirects.
# Must NOT have a trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# --- Reverse proxy -------------------------------------------
# Number of trusted proxy hops in front of the API.
# Use 0 for local development without a reverse proxy.
# Configure according to the actual production proxy topology.
TRUST_PROXY=0

# --- pgAdmin (Docker Compose only) ---------------------------
# Used by pgAdmin when it is configured in the infrastructure.
# Not consumed directly by the API.
PGADMIN_DEFAULT_EMAIL=admin@sircurty.local
PGADMIN_DEFAULT_PASSWORD=changeme
