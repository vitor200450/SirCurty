# ============================================================
# Sir Curty API — Environment variables template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Server --------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ------------------------------------------------
# Full PostgreSQL connection string.
# Used by Prisma (via prisma7.config.ts) and by the NestJS app.
POSTGRES_USER=sircurty
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sircurty

DATABASE_URL=postgresql://sircurty:changeme@localhost:5432/sircurty

# --- CORS ----------------------------------------------------
# Comma-separated list of allowed origins for browser requests.
# Must include the frontend origin (and credentials: true is set).
ALLOWED_ORIGINS=http://localhost:5173

# --- Public base URL -----------------------------------------
# Used to build short link URLs returned in API responses (shortUrl field).
# Must NOT have a trailing slash.
APP_BASE_URL=http://localhost:3000

# --- pgAdmin (compose only — not used by the app) -----------
PGADMIN_DEFAULT_EMAIL=admin@sircurty.local
PGADMIN_DEFAULT_PASSWORD=changeme
