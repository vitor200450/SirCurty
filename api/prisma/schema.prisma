// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LinkStatus {
  ACTIVE
  DISABLED
  DELETED

  @@map("link_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  googleSub String   @unique @map("google_sub") @db.VarChar(255)
  email     String   @unique @db.VarChar(320)
  name      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  links Link[]

  @@map("users")
}

model Link {
  id           Int        @id @default(autoincrement())
  slug         String     @unique @db.VarChar(64)
  originalUrl  String     @map("original_url") @db.VarChar(2048)
  ownerAnonId  String?    @map("owner_anon_id") @db.Char(64)
  ownerUserId  Int?       @map("owner_user_id")
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  isSingleUse  Boolean    @default(false) @map("is_single_use")
  usedAt       DateTime?  @map("used_at")
  expiresAt    DateTime?  @map("expires_at")
  status       LinkStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner  User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  clicks Click[]

  @@index([ownerAnonId], map: "idx_links_owner_anon_id")
  @@index([ownerUserId], map: "idx_links_owner_user_id")
  @@index([expiresAt], map: "idx_links_expires_at")
  @@index([status], map: "idx_links_status")
  @@map("links")
}

model Click {
  id        Int      @id @default(autoincrement())
  linkId    Int      @map("link_id")
  clickedAt DateTime @default(now()) @map("clicked_at")
  ipHash    String?  @map("ip_hash") @db.Char(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  referrer  String?  @db.VarChar(2048)
  country   String?  @db.Char(2)
  city      String?  @db.VarChar(100)
  isBot     Boolean  @default(false) @map("is_bot")

  link Link @relation(fields: [linkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([linkId, clickedAt], map: "idx_clicks_link_id_clicked_at")
  @@map("clicks")
}


model Session {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}
